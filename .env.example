# Firebase Web SDK config (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Local dev only — routes the Admin SDK (src/lib/firebase/admin.ts) at the
# Firebase emulators started via `pnpm emulators`. Do NOT set these in
# production/apphosting.yaml — App Hosting provides ambient Application
# Default Credentials and talks to real Firebase services; setting these
# there would make every session-cookie verification fail closed.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
